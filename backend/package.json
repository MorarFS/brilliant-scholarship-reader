  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/supertest": "7.2.1",
    "esbuild": "0.28.2",
    "supertest": "7.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
